{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overnight",
  "version": "0.1.8",
  "identifier": "dev.local.overnight",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Overnight",
        "width": 380,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "shortDescription": "Keeps the Mac awake overnight while Claude works",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGN0YxQjdFNTM3NkY4NDUKUldSRitIWlRmaHQvUHluNk1uMEhudTRFSmducnluZTdFdG45WWt4Z0RZejl2bGVhTXFCUkphMXYK",
      "endpoints": ["https://github.com/dienp/overnight/releases/latest/download/latest.json"]
    }
  }
}
